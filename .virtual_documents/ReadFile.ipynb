import asdf
from output_particle import *
import numpy
import pandas as pd
import matplotlib.pyplot as plt


af = asdf.open("exampledata/subsample8.0000.asdf")


af['header']


dat = af['data']['timeslice_subsample']


particles = unpack_output_particles_recarray(dat)


particles['pos']


pos = pd.DataFrame(particles['pos'], columns = ['x','y','z'])


poszslice = pos[(pos['z'] > -10)&(pos['z'] < 10)]
len(poszslice)


plt.scatter(poszslice['x'],poszslice['y'],s=0.7)
plt.xlim(0,200)
plt.ylim(0,200)
plt.xlabel("X Position (Mpc/h)")
plt.ylabel("Y Position (Mpc/h)")
plt.title("Redshift 0.1, Subsample \n 20 Mpc/h deep in Z direction")


vel = pd.DataFrame(particles['vel'], columns = ['vx','vy','vz'])


plt.figure()
plt.hist(vel['vx'],bins=np.linspace(-10,10,num=210))
plt.xlabel('X Velocity (km/s)')
plt.xlim(-10,10)

plt.figure()
plt.hist(vel['vy'],bins=300)
plt.xlabel('Y Velocity (km/s)')

plt.figure()
plt.hist(vel['vz'],bins=300)
plt.xlabel('Z Velocity (km/s)')


pid = pd.DataFrame(particles['pid'], columns = ['x','y','z'])


plt.scatter(pos['x'],pid['x'],s=0.1)
#pid: ordered triple, corresponds to original position


plt.hist(particles['vel_disp']==0,bins=100)


particles



